<?xml version="1.0" encoding="UTF-8"?><gpx version="1.1" creator="Jackson Hole Offline Map" xmlns="http://www.topografix.com/GPX/1/1"><metadata><name>Jackson Hole preliminary unverified trail</name><desc>NOT VERIFIED: route connects GPS photo positions</desc></metadata><wpt lat="37.51605977406413" lon="-88.60862900377097"><name>Stop 1</name><desc>Unverified trail stop</desc></wpt><wpt lat="37.51529077281672" lon="-88.60900936580683"><name>Stop 2</name><desc>Unverified trail stop</desc></wpt><wpt lat="37.513727014265136" lon="-88.60884237758226"><name>Stop 3</name><desc>Test your balance on the Make Do Bridge, or you can walk around.</desc></wpt><wpt lat="37.513108869616" lon="-88.60900472719197"><name>Stop 4</name><desc>Unverified trail stop</desc></wpt><wpt lat="37.512553914945734" lon="-88.60917259200957"><name>Stop 5</name><desc>Trail Intersection: Walk forward across Old Road Bed.</desc></wpt><wpt lat="37.51202711665827" lon="-88.60954280011033"><name>Stop 6</name><desc>Look for the Cedar with the Fairy House, then turn left to the top of the Waterfall.</desc></wpt><wpt lat="37.51185533444941" lon="-88.60986979897837"><name>Stop 8</name><desc>Unverified trail stop</desc></wpt><wpt lat="37.51172063550693" lon="-88.60990323333132"><name>Stop 7</name><desc>Be careful, slippery rocks.</desc></wpt><wpt lat="37.51173609145045" lon="-88.61006206978493"><name>Stop 8</name><desc>There is a trail around the top to the right. Another group of cascading waterfalls are around the corner. You can get to the bottom from the right side of this, EXTREME CAUTION IS ADVISED. </desc></wpt><trk><name>PRELIMINARY UNVERIFIED ROUTE</name><trkseg><trkpt lat="37.51605977406413" lon="-88.60862900377097"/><trkpt lat="37.51529077281672" lon="-88.60900936580683"/><trkpt lat="37.513727014265136" lon="-88.60884237758226"/><trkpt lat="37.51366268508692" lon="-88.60897991141503"/><trkpt lat="37.513108869616" lon="-88.60900472719197"/><trkpt lat="37.512553914945734" lon="-88.60917259200957"/><trkpt lat="37.51202711665827" lon="-88.60954280011033"/><trkpt lat="37.51185533444941" lon="-88.60986979897837"/><trkpt lat="37.51172063550693" lon="-88.60990323333132"/><trkpt lat="37.51173609145045" lon="-88.61006206978493"/></trkseg></trk></gpx>